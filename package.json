{
  "name": "docufast-agent",
  "version": "2.0.1",
  "description": "DocuFast India \u2014 print shop app for Windows",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64",
    "build:installer": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "in.docufast.agent",
    "productName": "DocuFast",
    "copyright": "Copyright \u00a9 2026 DocuFast India",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "DocuFast India"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DocuFast",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "runAfterFinish": true,
      "license": null,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "deleteAppDataOnUninstall": false,
      "artifactName": "DocuFast-Setup.exe"
    },
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "src/**/*",
      "dashboard/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "syedfayazali",
      "repo": "Docufast-Desktop",
      "releaseType": "release"
    },
    "directories": {
      "buildResources": "build"
    }
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "node-fetch": "^3.3.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}